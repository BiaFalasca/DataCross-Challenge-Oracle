    "def classificar_score(score, bloqueio=False):\n",
    "    if score >= 70 and not bloqueio:\n",
    "        return \"APTO para avaliação de alta/reabilitação\"\n",
    "    elif score >= 40 and not bloqueio:\n",
    "        return \"REAVALIAR em 24 horas\"\n",
    "    else:\n",
    "        return \"PERMANECE INTERNADO\""
   ]
